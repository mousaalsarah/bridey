{
  "name": "bridey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/prisma-generate.mjs && node scripts/prisma-migrate-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:sync-postgres": "node scripts/sync-postgres-schema.mjs",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "setup": "prisma generate --schema prisma/schema.prisma && prisma db push --schema prisma/schema.prisma && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
