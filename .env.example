# --- Local development (SQLite) ---
DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel + Supabase (PostgreSQL) ---
# DATABASE_URL is the Supabase SESSION pooler URI (port 5432 on the pooler host).
# Do not use transaction-mode port 6543 — Bridey booking uses interactive Prisma transactions.
# DIRECT_URL is the direct Postgres URI (port 5432 on db.<project>.supabase.co), used for migrations.
# AUTH_SECRET must be a long random string. Generate with: openssl rand -base64 48
# NEXT_PUBLIC_APP_URL is the public origin testers will open, e.g. https://your-app.vercel.app
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
#
# Optional one-off admin bootstrap (run locally against the deployed DB, not during Vercel build):
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="choose-a-strong-password"
# ADMIN_NAME="Bridey Admin"
#
# Demo seed is local-only. Never run it on the live test DB unless you explicitly set:
# ALLOW_DEMO_SEED="1"

# --- Optional local Flask API (feat/flask-api) ---
# Run `python app.py` from backend/, then set this so Next.js /api/* is proxied to Flask.
# Leave unset on Vercel until a deliberate cutover (also requires FLASK_API_CUTOVER=1).
# FLASK_API_ORIGIN="http://127.0.0.1:5000"
# FLASK_API_CUTOVER="1"
