# Copy to backend/.env or keep using the repo-root .env.
# Flask reads backend/.env first, then the Next.js .env in the repo root.

# Same values the Next.js app uses.
# Local Prisma SQLite (relative to prisma/):
DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# Production / Lambda: session-mode Postgres (port 5432), never PgBouncer 6543.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# AUTH_SECRET must be a long random string.

FLASK_DEBUG=1
PORT=5000

# Optional: Next.js local proxy. Set the same value in the repo-root .env as FLASK_API_ORIGIN.
# FLASK_API_ORIGIN="http://127.0.0.1:5000"
